#!/bin/sh
# classnet -- CS 326 classroom network control.
#
# Source of truth lives in /etc/classnet.  `classnet apply` regenerates every
# UCI section this tool owns (all named after CLASS) from those files, so the
# router config is reproducible and the repo diff is the whole story.

set -u

CONF_DIR=/etc/classnet
CONF="$CONF_DIR/classnet.conf"
ALLOW_DIR="$CONF_DIR/allow.d"
DENY="$CONF_DIR/deny.list"
STATIC4="$CONF_DIR/static4.list"
MACS="$CONF_DIR/staff-macs.list"
# Operator state lives on disk, not just in UCI: `classnet apply` regenerates
# every section it owns, so without these a later `classnet staff add` would
# silently re-enable a disabled SSID or re-lock an unlocked network.
FLAG_OFF="$CONF_DIR/state-ssid-disabled"
FLAG_OPEN="$CONF_DIR/state-unlocked"
FLAG_DBG="$CONF_DIR/state-debug"
FLAG_GATE="$CONF_DIR/state-gate-on"
FLAG_SCHED="$CONF_DIR/state-schedule-on"
# The Wi-Fi uplink is operator state too, but it carries values, one of them
# somebody else's passphrase. Four plain lines -- ssid, key, radio, encryption --
# read back a line at a time and never sourced, so nothing in an SSID or a
# password is ever evaluated. Absent means the wired WAN port.
UPLINK="$CONF_DIR/state-uplink"
UPLINK_PREV=/tmp/classnet-uplink.prev
UPLINK_MISS=/tmp/classnet-uplink-miss
UPLINK_NOTE=/tmp/classnet-uplink-dropped
GARDEN="$CONF_DIR/garden.list"
PROBES="$CONF_DIR/probe.list"
REGTSV="$CONF_DIR/registrations.tsv"
REGMACS="$CONF_DIR/registered.macs"
ATTEND="$CONF_DIR/attendance"
SCHEDULE="$CONF_DIR/schedule.conf"
ADHOC="$ATTEND/sessions.log"
PORTAL_PORT=8080
MARK=0x326

ALWAYS_ON="core github site"

die() { echo "classnet: $*" >&2; exit 1; }
info() { echo "  $*"; }

[ -f "$CONF" ] || die "missing $CONF"
# shellcheck disable=SC1090
. "$CONF"

: "${CLASS:?set CLASS in $CONF}" "${SSID:?}" "${KEY:?}" "${NET:?}"
: "${STAFF_SSID:?}" "${STAFF_KEY:?}" "${STAFF_NET:?}"

# The class name drives every generated identifier: SSID, firewall zones,
# nftables sets, bridges, UCI section names. Constrained because those are not
# all equally forgiving -- a Linux interface name caps at 15 characters and
# "br-" plus the class has to fit, and UCI section names are identifiers.
echo "$CLASS" | grep -qE '^[a-z][a-z0-9]{1,10}$' \
	|| die "CLASS must be 2-11 characters, lowercase letters and digits, starting with a letter (got '$CLASS')"
C="$CLASS"
: "${COUNTRY:=US}" "${UPSTREAM_DNS:=1.1.1.1}" "${PROFILES:=}"
: "${PORTAL_HOST:=signin.$CLASS}" "${CAPTIVE_POPUP:=0}" "${SESSION_BUFFER_MIN:=5}" "${SESSION_GAP_MIN:=10}" "${RETAIN_DAYS:=150}"
# No colon: an unset ONLINE_HOST takes the default, but one set to "" is an
# operator switching the who-is-online page off, not an omission to fill in.
: "${ONLINE_HOST=online.$CLASS}"
: "${STAFF_HIDDEN:=0}" "${ALLOW_TCP:=22 80 443}" "${ALLOW_UDP:=443}"
: "${UPLINK_GIVEUP_MIN:=5}"

CLASS_IP="$NET.1"
STAFF_IP="$STAFF_NET.1"
WWAN="${C}wwan"

# ---------------------------------------------------------------- helpers ---

# strip comments (whole-line and trailing) and blanks
strip() { sed -e 's/[[:space:]]*#.*$//' -e 's/[[:space:]]*$//' -e '/^$/d' "$@"; }

profile_of() { basename "$1" .list | sed 's/^[0-9]*-//'; }

ssid_off()   { [ -f "$FLAG_OFF" ]; }
is_unlocked(){ [ -f "$FLAG_OPEN" ]; }
is_debug()   { [ -f "$FLAG_DBG" ]; }
# The registration gate is opt-in: turning it on mid-session would cut off
# every already-connected laptop at once, so it must be a deliberate act.
gate_on()    { [ -f "$FLAG_GATE" ]; }
uplink_wifi(){ [ -s "$UPLINK" ]; }
# 1 ssid, 2 key, 3 radio, 4 encryption
uplink_get() { sed -n "${1}p" "$UPLINK" 2>/dev/null; }

garden_domains(){ [ -f "$GARDEN" ] && strip "$GARDEN" | awk '!s[$0]++'; }
probe_domains() { [ -f "$PROBES" ] && strip "$PROBES" | awk '!s[$0]++'; }
registrations() { [ -f "$REGTSV" ] && grep -v '^#' "$REGTSV" 2>/dev/null | grep -v '^$'; }

profile_enabled() {
	# `local` matters: callers loop over profiles in a variable named p, and
	# a bare `for p` here would clobber theirs on the not-found path.
	local x
	for x in $ALWAYS_ON; do [ "$x" = "$1" ] && return 0; done
	for x in $PROFILES; do [ "$x" = "$1" ] && return 0; done
	return 1
}

# every allowlisted domain, deduped, in file order
domains() {
	for f in "$ALLOW_DIR"/*.list; do
		[ -f "$f" ] || continue
		profile_enabled "$(profile_of "$f")" || continue
		strip "$f"
	done | awk '!seen[$0]++'
}

denied()    { [ -f "$DENY" ] && strip "$DENY" | awk '!seen[$0]++'; }
staff_macs(){ [ -f "$MACS" ] && strip "$MACS" | tr 'A-Z' 'a-z' | awk '!seen[$0]++'; }

# delete every UCI section this tool owns in the given config
wipe() {
	uci show "$1" 2>/dev/null | sed -n "s/^\($1\.${C}[a-z0-9_]*\)=.*/\1/p" \
		| sort -u | while read -r s; do uci -q delete "$s"; done
}

# ------------------------------------------------------------------ apply ---

apply_network() {
	wipe network
	uci set network.${C}_dev=device
	uci set network.${C}_dev.name="br-${C}"
	uci set network.${C}_dev.type='bridge'
	uci set network.${C}=interface
	uci set network.${C}.device="br-${C}"
	uci set network.${C}.proto='static'
	uci set network.${C}.ipaddr="$CLASS_IP"
	uci set network.${C}.netmask='255.255.255.0'
	# no ip6assign: IPv6 is off on the student segment on purpose.

	uci set network.${C}s_dev=device
	uci set network.${C}s_dev.name="br-${C}s"
	uci set network.${C}s_dev.type='bridge'
	uci set network.${C}staff=interface
	uci set network.${C}staff.device="br-${C}s"
	uci set network.${C}staff.proto='static'
	uci set network.${C}staff.ipaddr="$STAFF_IP"
	uci set network.${C}staff.netmask='255.255.255.0'
	uci set network.${C}staff.ip6assign='60'

	# The Wi-Fi uplink, when there is one. The metric is what lets it sit beside
	# the stock wan without touching it: wan has none, which is 0, so a cable in
	# the WAN port still wins, and with nothing plugged in this is the only
	# default route there is.
	if uplink_wifi; then
		uci set network.${WWAN}=interface
		uci set network.${WWAN}.proto='dhcp'
		uci set network.${WWAN}.metric='20'
	fi
}

apply_wireless() {
	wipe wireless
	# retire the stock disabled "OpenWrt" APs
	uci -q delete wireless.default_radio0
	uci -q delete wireless.default_radio1

	for r in 0 1; do
		uci -q get "wireless.radio$r" >/dev/null || continue
		uci set "wireless.radio$r.country=$COUNTRY"
		uci set "wireless.radio$r.disabled=0"
	done

	ssid_off && off=1 || off=0
	_ap ${C}_2g  radio0 "$SSID" "$KEY" "$C"        0 "$off"
	_ap ${C}_5g  radio1 "$SSID" "$KEY" "$C"        0 "$off"
	_ap ${C}s_2g radio0 "$STAFF_SSID" "$STAFF_KEY" ${C}staff "$STAFF_HIDDEN" 0
	_ap ${C}s_5g radio1 "$STAFF_SSID" "$STAFF_KEY" ${C}staff "$STAFF_HIDDEN" 0

	# The uplink client shares a radio with the APs above, and that radio has
	# one channel. hostapd stops every AP on it while the client is not
	# associated and restarts them on the client's channel once it is. That is
	# why the client goes on ONE radio: the other band never depends on someone
	# else's network, and is the way back in when this one is dark.
	if uplink_wifi && uci -q get "wireless.$(uplink_get 3)" >/dev/null; then
		uci set wireless.${C}_sta=wifi-iface
		uci set "wireless.${C}_sta.device=$(uplink_get 3)"
		uci set wireless.${C}_sta.mode='sta'
		uci set wireless.${C}_sta.network="$WWAN"
		uci set "wireless.${C}_sta.ssid=$(uplink_get 1)"
		uci set "wireless.${C}_sta.encryption=$(uplink_get 4)"
		uci set "wireless.${C}_sta.key=$(uplink_get 2)"
	fi
}

_ap() {
	sec="$1"; dev="$2"; ssid="$3"; key="$4"; net="$5"; hidden="$6"; off="$7"
	uci -q get "wireless.$dev" >/dev/null || return 0
	uci set "wireless.$sec=wifi-iface"
	uci set "wireless.$sec.device=$dev"
	uci set "wireless.$sec.mode=ap"
	uci set "wireless.$sec.ssid=$ssid"
	uci set "wireless.$sec.network=$net"
	uci set "wireless.$sec.encryption=psk2+ccmp"
	uci set "wireless.$sec.key=$key"
	uci set "wireless.$sec.hidden=$hidden"
	uci set "wireless.$sec.isolate=0"
	uci set "wireless.$sec.disabled=$off"
}

apply_dhcp() {
	wipe dhcp

	# Name the stock instance so sections can be bound to it explicitly.
	# Sections with no `instance` are inherited by EVERY instance
	# (/etc/init.d/dnsmasq filter_dnsmasq), which would otherwise leak the
	# lan config into the filtered classnet resolver.
	uci -q get dhcp.main >/dev/null 2>&1 || uci -q rename dhcp.@dnsmasq[0]='main'
	uci set dhcp.main.instance='main'
	for s in lan wan; do
		uci -q get "dhcp.$s" >/dev/null 2>&1 && uci set "dhcp.$s.instance=main"
	done
	# main serves everything except the student segment
	uci -q del_list dhcp.main.notinterface="$C"
	uci add_list dhcp.main.notinterface="$C"

	# ...and the class domain is ours, so main answers for it instead of
	# forwarding it. An empty server for a domain is what --local means: never
	# ask upstream. Without this a staff laptop that asks for a class name
	# before that name exists is answered by the ROOT servers, whose NXDOMAIN
	# carries an SOA with a 24-hour negative TTL -- and the name then stays
	# broken on that laptop for a day after the router is right. Added as a
	# list, because dhcp.main.local is the stock '/lan/' and setting it would
	# take .lan down with it.
	uci -q del_list dhcp.main.server="/$C/"
	uci add_list dhcp.main.server="/$C/"

	# ---- the filtered resolver -------------------------------------------
	uci set dhcp.${C}=dnsmasq
	uci add_list dhcp.${C}.interface="$C"
	# dnsmasq adds loopback automatically whenever --interface is used; without
	# this the second instance collides with main on 127.0.0.1:53 and dies.
	uci add_list dhcp.${C}.notinterface='lo'
	uci set dhcp.${C}.nonwildcard='1'      # --bind-dynamic, classnet iface only
	uci set dhcp.${C}.localservice='1'
	uci set dhcp.${C}.noresolv='1'         # ignore the WAN-learned resolvers
	uci set dhcp.${C}.localuse='0'         # do not rewrite /tmp/resolv.conf
	uci set dhcp.${C}.authoritative='1'
	uci set dhcp.${C}.rebind_protection='0'
	uci set dhcp.${C}.domain="$C"
	uci set dhcp.${C}.local="/$C/"
	uci set dhcp.${C}.expandhosts='1'
	# Every instance reads the whole of /tmp/hosts, not just its own file, so a
	# name that both resolvers answer for -- the who-is-online page below, and
	# the stock "OpenWrt" record -- has one A record per network visible here.
	# localise-queries picks the one on the subnet the query arrived from,
	# which is how the stock instance already handles it and why it is on there
	# by default. Without it a student would get the staff address half the
	# time, which reads as an intermittently broken page rather than a
	# misconfigured one.
	uci set dhcp.${C}.localise_queries='1'
	uci set dhcp.${C}.cachesize='2000'
	uci set dhcp.${C}.leasefile="/tmp/dhcp.${C}.leases"
	uci set dhcp.${C}.domainneeded='1'
	uci set dhcp.${C}.boguspriv='1'
	# The student segment is v4-only and the allow set is v4-only, so an AAAA
	# answer can only ever produce a stalled connection attempt.
	uci set dhcp.${C}.filter_aaaa='1'
	is_debug && uci set dhcp.${C}.logqueries='1'

	# allowlist: one --server per (domain, upstream). More specific than the
	# /#/ catch-all below, so these are the only names that ever resolve.
	domains | while read -r d; do
		for u in $UPSTREAM_DNS; do
			uci add_list "dhcp.${C}.server=/$d/$u"
		done
	done

	# The garden resolves for everyone; the firewall, not DNS, is what keeps a
	# registered student out of it.
	garden_domains | while read -r d; do
		for u in $UPSTREAM_DNS; do
			uci add_list "dhcp.${C}.server=/$d/$u"
		done
	done

	probe_domains | while read -r d; do
		for u in $UPSTREAM_DNS; do
			uci add_list "dhcp.${C}.server=/$d/$u"
		done
	done

	# denylist: empty address == NXDOMAIN, and more specific than any
	# broader allow entry someone might add later.
	denied | while read -r d; do
		uci add_list "dhcp.${C}.address=/$d/"
	done

	if is_unlocked; then
		# Escape hatch: resolve everything. The deny list above still stands,
		# so unlocking restores Internet access without restoring Copilot.
		for u in $UPSTREAM_DNS; do uci add_list "dhcp.${C}.server=$u"; done
	else
		# default deny. `/#/` matches anything not claimed by a --server above.
		uci add_list dhcp.${C}.address='/#/'
	fi

	# A name for the portal, so students are given words rather than an IP.
	#
	# A hosts-file record rather than address=/name/ip on purpose. address=
	# answers the AAAA query with NXDOMAIN, and a musl getaddrinfo treats that
	# as "no such host" for the whole lookup and throws the perfectly good A
	# record away -- the name resolves under nslookup and is unusable to every
	# client on the machine. A hosts record returns NODATA for AAAA, which is
	# what "this name has no IPv6" is actually supposed to look like.
	uci set dhcp.${C}_host=domain
	uci set dhcp.${C}_host.instance="$C"
	uci set dhcp.${C}_host.name="$PORTAL_HOST ${PORTAL_HOST%%.*}"
	uci set dhcp.${C}_host.ip="$CLASS_IP"

	# ...and a name for the who-is-online page, which unlike the portal is
	# answered on BOTH class networks. Two records for one name, deliberately:
	# each side is told the router's address on its own network, so neither has
	# to route into the other to read the page. They do not conflict because
	# both resolvers have localise-queries, which answers with the address on
	# the subnet the query came from. The staff record goes to the main
	# instance because that is the resolver the staff SSID is served by.
	if [ -n "$ONLINE_HOST" ]; then
		uci set dhcp.${C}_online=domain
		uci set dhcp.${C}_online.instance="$C"
		uci set dhcp.${C}_online.name="$ONLINE_HOST ${ONLINE_HOST%%.*}"
		uci set dhcp.${C}_online.ip="$CLASS_IP"

		uci set dhcp.${C}_sonline=domain
		uci set dhcp.${C}_sonline.instance='main'
		uci set dhcp.${C}_sonline.name="$ONLINE_HOST ${ONLINE_HOST%%.*}"
		uci set dhcp.${C}_sonline.ip="$STAFF_IP"
	fi

	# resolved answers for allowlisted names land in the firewall set
	uci set dhcp.${C}_ipset=ipset
	uci set dhcp.${C}_ipset.instance="$C"
	uci add_list dhcp.${C}_ipset.name="${C}_dns4"
	uci set dhcp.${C}_ipset.table='fw4'
	uci set dhcp.${C}_ipset.table_family='inet'
	uci set dhcp.${C}_ipset.family='4'
	domains | while read -r d; do
		uci add_list "dhcp.${C}_ipset.domain=$d"
	done

	# garden answers land in their own set, never in ${C}_dns4
	uci set dhcp.${C}_gipset=ipset
	uci set dhcp.${C}_gipset.instance="$C"
	uci add_list dhcp.${C}_gipset.name="${C}_garden4"
	uci set dhcp.${C}_gipset.table='fw4'
	uci set dhcp.${C}_gipset.table_family='inet'
	uci set dhcp.${C}_gipset.family='4'
	garden_domains | while read -r d; do
		uci add_list "dhcp.${C}_gipset.domain=$d"
	done

	uci set dhcp.${C}_pipset=ipset
	uci set dhcp.${C}_pipset.instance="$C"
	uci add_list dhcp.${C}_pipset.name="${C}_probe4"
	uci set dhcp.${C}_pipset.table='fw4'
	uci set dhcp.${C}_pipset.table_family='inet'
	uci set dhcp.${C}_pipset.family='4'
	probe_domains | while read -r d; do
		uci add_list "dhcp.${C}_pipset.domain=$d"
	done

	uci set dhcp.${C}_pool=dhcp
	uci set dhcp.${C}_pool.instance="$C"
	uci set dhcp.${C}_pool.interface="$C"
	uci set dhcp.${C}_pool.start='100'
	uci set dhcp.${C}_pool.limit='150'
	uci set dhcp.${C}_pool.leasetime='4h'
	uci set dhcp.${C}_pool.dhcpv4='server'
	uci set dhcp.${C}_pool.dhcpv6='disabled'
	uci set dhcp.${C}_pool.ra='disabled'
	# option 42 = NTP. TLS fails on a skewed clock and every allowlisted
	# host is TLS-only, so hand out the router as a time source.
	uci add_list "dhcp.${C}_pool.dhcp_option=42,$CLASS_IP"
	# No explicit option 6 here: dnsmasq advertises itself as the resolver by
	# default, so the tagged staff override below wins outright rather than
	# tying with a pool-level option on tag count.

	# Staff machines on the student SSID get a public resolver instead of the
	# filtered one. They can reach it because the MAC rule in apply_firewall
	# gives them a full ACCEPT to wan, and because they are exempted from the
	# port-53 redirect. Without this the MAC bypass is only half a bypass:
	# unrestricted routing but no way to resolve anything.
	if [ -n "$(staff_macs)" ]; then
		set -- $UPSTREAM_DNS
		uci set dhcp.${C}stafftag=tag
		uci add_list "dhcp.${C}stafftag.dhcp_option=6,$1"
		i=0
		staff_macs | while read -r m; do
			i=$((i+1))
			uci set "dhcp.${C}staffhost$i=host"
			uci set "dhcp.${C}staffhost$i.instance=$C"
			uci add_list "dhcp.${C}staffhost$i.mac=$m"
			uci set "dhcp.${C}staffhost$i.tag=${C}stafftag"
			# A name is required: dhcp_host_add() in /etc/init.d/dnsmasq
			# returns early unless ip, name or hostid is set, so a
			# mac+tag-only section is silently dropped.
			uci set "dhcp.${C}staffhost$i.name=${C}staff$i"
		done
	fi

	uci set dhcp.${C}staff_pool=dhcp
	uci set dhcp.${C}staff_pool.instance='main'
	uci set dhcp.${C}staff_pool.interface="${C}staff"
	uci set dhcp.${C}staff_pool.start='100'
	uci set dhcp.${C}staff_pool.limit='100'
	uci set dhcp.${C}staff_pool.leasetime='12h'
	uci set dhcp.${C}staff_pool.dhcpv4='server'
}

apply_firewall() {
	wipe firewall

	# DNS-learned addresses. dest_ip (not dest_net) => a plain ipv4_addr set;
	# an interval set would reject the bare addresses dnsmasq inserts.
	uci set firewall.${C}_set_dns=ipset
	uci set firewall.${C}_set_dns.name="${C}_dns4"
	uci set firewall.${C}_set_dns.family='ipv4'
	uci add_list firewall.${C}_set_dns.match='dest_ip'
	uci set firewall.${C}_set_dns.timeout='86400'

	# static CIDRs (GitHub Pages edge) -- survives DoH clients
	uci set firewall.${C}_set_net=ipset
	uci set firewall.${C}_set_net.name="${C}_net4"
	uci set firewall.${C}_set_net.family='ipv4'
	uci add_list firewall.${C}_set_net.match='dest_net'
	uci set firewall.${C}_set_net.loadfile="$STATIC4"

	# Registered devices, by MAC. Loaded at firewall start; the portal also
	# adds elements live with `nft add element`, so registering a student
	# never reloads the ruleset and never disturbs anyone already connected.
	uci set firewall.${C}_set_reg=ipset
	uci set firewall.${C}_set_reg.name="${C}_reg"
	uci add_list firewall.${C}_set_reg.match='src_mac'
	uci set firewall.${C}_set_reg.loadfile="$REGMACS"

	# Pre-auth walled garden, DNS-fed like ${C}_dns4.
	uci set firewall.${C}_set_gar=ipset
	uci set firewall.${C}_set_gar.name="${C}_garden4"
	uci set firewall.${C}_set_gar.family='ipv4'
	uci add_list firewall.${C}_set_gar.match='dest_ip'
	uci set firewall.${C}_set_gar.timeout='86400'

	uci set firewall.${C}_set_probe=ipset
	uci set firewall.${C}_set_probe.name="${C}_probe4"
	uci set firewall.${C}_set_probe.family='ipv4'
	uci add_list firewall.${C}_set_probe.match='dest_ip'
	uci set firewall.${C}_set_probe.timeout='86400'

	uci set firewall.${C}_zone=zone
	uci set firewall.${C}_zone.name="$C"
	uci add_list firewall.${C}_zone.network="$C"
	uci set firewall.${C}_zone.input='REJECT'
	uci set firewall.${C}_zone.output='ACCEPT'
	uci set firewall.${C}_zone.forward='REJECT'

	uci set firewall.${C}_szone=zone
	uci set firewall.${C}_szone.name="${C}staff"
	uci add_list firewall.${C}_szone.network="${C}staff"
	uci set firewall.${C}_szone.input='REJECT'
	uci set firewall.${C}_szone.output='ACCEPT'
	uci set firewall.${C}_szone.forward='REJECT'

	uci set firewall.${C}_sfwd=forwarding
	uci set firewall.${C}_sfwd.src="${C}staff"
	uci set firewall.${C}_sfwd.dest='wan'

	# escape hatch: `classnet unlock` enables this, giving the student SSID
	# unrestricted access without dropping anyone off the network.
	uci set firewall.${C}_unlock=forwarding
	uci set firewall.${C}_unlock.src="$C"
	uci set firewall.${C}_unlock.dest='wan'
	is_unlocked && uci set firewall.${C}_unlock.enabled='1' \
	            || uci set firewall.${C}_unlock.enabled='0'

	_svc ${C}_in_dhcp   "$C" udp 67  "$C DHCP"
	_svc ${C}_in_dns    "$C" 'tcp udp' 53 "$C DNS"
	_svc ${C}_in_ntp    "$C" udp 123 "$C NTP"
	_svc ${C}_sin_dhcp  ${C}staff udp 67  'staff DHCP'
	_svc ${C}_sin_dns   ${C}staff 'tcp udp' 53 'staff DNS'
	_svc ${C}_sin_ntp   ${C}staff udp 123 'staff NTP'

	# Management access: ssh to the router from the staff SSID. The staff zone
	# has input REJECT, so without this a staff laptop can only reach the
	# resolver -- not dropbear, on any of the router's addresses.
	_svc ${C}_sin_ssh   ${C}staff tcp 22  'staff SSH'

	# staff MAC bypass -- only created when at least one MAC is configured,
	# because a src_mac rule with an empty list matches EVERYTHING.
	if [ -n "$(staff_macs)" ]; then
		uci set firewall.${C}_staffmac=rule
		uci set firewall.${C}_staffmac.name="$C-staff-mac-bypass"
		uci set firewall.${C}_staffmac.src="$C"
		uci set firewall.${C}_staffmac.dest='wan'
		uci set firewall.${C}_staffmac.proto='all'   # incl. ICMP, not just tcp/udp
		uci set firewall.${C}_staffmac.target='ACCEPT'
		staff_macs | while read -r m; do
			uci add_list "firewall.${C}_staffmac.src_mac=$m"
		done
	fi

	if gate_on; then
		# One fw4 rule carries only one ipset, so the registered-MAC test and
		# the allowed-destination test cannot live in the same rule. Mark in
		# mangle_forward (priority -150) and match the mark in filter forward
		# (priority 0), which runs after it.
		uci set firewall.${C}_mark=rule
		uci set firewall.${C}_mark.name="$C-mark-registered"
		uci set firewall.${C}_mark.src="$C"
		uci set firewall.${C}_mark.dest='wan'
		uci set firewall.${C}_mark.proto='all'
		uci set firewall.${C}_mark.ipset="${C}_reg"
		uci set firewall.${C}_mark.set_mark="$MARK"
		uci set firewall.${C}_mark.target='MARK'

		_allow ${C}_allow_dns ${C}_dns4    "$ALLOW_TCP" "$ALLOW_UDP" "$MARK"
		_allow ${C}_allow_net ${C}_net4    "80 443"     "$ALLOW_UDP" "$MARK"
		# unregistered devices reach the sign-in garden and nothing else
		_allow ${C}_garden    ${C}_garden4 "80 443"     "443"        "!$MARK"
		# Let the OS connectivity check succeed, registered or not. Without it
		# macOS decides the network is captive and will not let the browser out
		# at all -- including to the sign-in page the student needs -- and after
		# sign-in it would keep insisting there is no Internet.
		_allow ${C}_probe     ${C}_probe4  "80 443"     "443"

		# ...and their plain-HTTP goes to the portal, which is what makes the
		# captive-portal sheet open by itself. A redirect can match the MAC set
		# directly, so this needs no mark and no ordering assumption.
		#
		# Off by default. DNAT runs in prerouting, before the forward rules, so
		# it catches the OS connectivity probe as well; macOS then flags the
		# network captive and refuses to let Safari reach the sign-in host at
		# all. The pop-up appears and sign-in cannot be completed from it --
		# verified: DNS resolved and not one packet left the Mac. A sign-in
		# that cannot be completed is worse than one that must be announced.
		if [ "$CAPTIVE_POPUP" = 1 ]; then
		uci set firewall.${C}_portal=redirect
		uci set firewall.${C}_portal.name="$C-portal-intercept"
		uci set firewall.${C}_portal.src="$C"
		uci set firewall.${C}_portal.proto='tcp'
		uci set firewall.${C}_portal.src_dport='80'
		uci set firewall.${C}_portal.dest_ip="$CLASS_IP"
		uci set firewall.${C}_portal.dest_port="$PORTAL_PORT"
		uci set firewall.${C}_portal.ipset="!${C}_reg"
		uci set firewall.${C}_portal.target='DNAT'
		fi
	else
		_allow ${C}_allow_dns ${C}_dns4 "$ALLOW_TCP" "$ALLOW_UDP"
		_allow ${C}_allow_net ${C}_net4 "80 443"     "$ALLOW_UDP"
	fi

	# Reaching the router's own pages is not conditioned on the gate. It used to
	# be, and that was wrong in both directions: with the gate off the sign-in
	# page still earns its keep, because the identity it binds is what
	# attendance is reported under, and the who-is-online page has nothing to do
	# with the gate at all.
	_svc ${C}_in_portal "$C" tcp "$PORTAL_PORT" "$C portal"

	# Plain http to the router itself lands on the portal, so the address a
	# student is given is just the router IP with no port. src_dip keeps this
	# to packets already addressed here: it is not interception, and in
	# particular it leaves the OS connectivity probe alone.
	uci set firewall.${C}_portal80=redirect
	uci set firewall.${C}_portal80.name="$C-portal-on-80"
	uci set firewall.${C}_portal80.src="$C"
	uci set firewall.${C}_portal80.proto=tcp
	uci set firewall.${C}_portal80.src_dip="$CLASS_IP"
	uci set firewall.${C}_portal80.src_dport=80
	uci set firewall.${C}_portal80.dest_ip="$CLASS_IP"
	uci set firewall.${C}_portal80.dest_port="$PORTAL_PORT"
	uci set firewall.${C}_portal80.target=DNAT

	# The same page from the staff SSID, on the staff side of the router. The
	# staff zone is input REJECT, so without these two a TA gets nothing; with
	# them a TA gets the who-is-online page and nothing else, because the portal
	# serves only that page to requests arriving on this address.
	if [ -n "$ONLINE_HOST" ]; then
		_svc ${C}_sin_portal ${C}staff tcp "$PORTAL_PORT" 'staff portal'

		uci set firewall.${C}_sportal80=redirect
		uci set firewall.${C}_sportal80.name="$C-staff-portal-on-80"
		uci set firewall.${C}_sportal80.src="${C}staff"
		uci set firewall.${C}_sportal80.proto=tcp
		uci set firewall.${C}_sportal80.src_dip="$STAFF_IP"
		uci set firewall.${C}_sportal80.src_dport=80
		uci set firewall.${C}_sportal80.dest_ip="$STAFF_IP"
		uci set firewall.${C}_sportal80.dest_port="$PORTAL_PORT"
		uci set firewall.${C}_sportal80.target=DNAT
	fi

	# fail fast instead of hanging when a client tries DNS-over-TLS
	uci set firewall.${C}_no_dot=rule
	uci set firewall.${C}_no_dot.name="$C-block-dot"
	uci set firewall.${C}_no_dot.src="$C"
	uci set firewall.${C}_no_dot.dest='wan'
	uci set firewall.${C}_no_dot.dest_port='853'
	uci set firewall.${C}_no_dot.proto='tcp udp'
	uci set firewall.${C}_no_dot.target='REJECT'

	# drop IPv6 forwarding outright -- the student segment is v4-only
	uci set firewall.${C}_no_v6=rule
	uci set firewall.${C}_no_v6.name="$C-drop-ipv6"
	uci set firewall.${C}_no_v6.src="$C"
	uci set firewall.${C}_no_v6.dest='*'
	uci set firewall.${C}_no_v6.family='ipv6'
	uci set firewall.${C}_no_v6.proto='all'
	uci set firewall.${C}_no_v6.target='DROP'

	# a laptop with a hardcoded 8.8.8.8 still gets filtered answers
	uci set firewall.${C}_dnat53=redirect
	uci set firewall.${C}_dnat53.name="$C-force-dns"
	uci set firewall.${C}_dnat53.src="$C"
	uci set firewall.${C}_dnat53.proto='tcp udp'
	uci set firewall.${C}_dnat53.src_dport='53'
	uci set firewall.${C}_dnat53.dest_ip="$CLASS_IP"
	uci set firewall.${C}_dnat53.dest_port='53'
	uci set firewall.${C}_dnat53.target='DNAT'
	if ssid_off; then
		for r in ${C}_allow_dns_t ${C}_allow_dns_u ${C}_allow_net_t \
		         ${C}_allow_net_u ${C}_staffmac ${C}_no_dot ${C}_dnat53; do
			uci -q get "firewall.$r" >/dev/null && uci set "firewall.$r.enabled=0"
		done
	fi
	# ...but never hijack staff DNS (fw4 parse_mac honours a leading '!')
	staff_macs | while read -r m; do
		uci add_list "firewall.${C}_dnat53.src_mac=!$m"
	done

	# The Wi-Fi uplink joins the STOCK wan zone rather than getting one of its
	# own: every rule above already says dest=wan, and that zone is where the
	# masquerading lives. Edited only when the answer changes, so an apply on a
	# wired uplink leaves a section this tool does not own exactly as it was.
	u_zone=$(wan_zone); u_in=0
	[ -n "$u_zone" ] && uci -q get "firewall.$u_zone.network" | tr ' ' '\n' | grep -qx "$WWAN" && u_in=1
	if uplink_wifi; then
		if [ -z "$u_zone" ]; then
			uci revert network; uci revert wireless; uci revert dhcp; uci revert firewall
			die "no firewall zone named 'wan' to put the Wi-Fi uplink in -- nothing applied"
		fi
		[ $u_in = 1 ] || uci add_list "firewall.$u_zone.network=$WWAN"
	elif [ $u_in = 1 ]; then
		uci del_list "firewall.$u_zone.network=$WWAN"
	fi
}

# The stock zone the uplink joins, as a UCI section. Looked up by name and then
# checked for type, because a rule may be called 'wan' as well.
wan_zone() {
	uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.=]*\)\.name='wan'$/\1/p" \
		| while read -r s; do
			[ "$(uci -q get "firewall.$s")" = zone ] && { echo "$s"; break; }
		done
}

_svc() {
	sec="$1"; zone="$2"; proto="$3"; port="$4"; label="$5"
	uci set "firewall.$sec=rule"
	uci set "firewall.$sec.name=$label"
	uci set "firewall.$sec.src=$zone"
	uci set "firewall.$sec.proto=$proto"
	uci set "firewall.$sec.dest_port=$port"
	uci set "firewall.$sec.target=ACCEPT"
}

_allow() {
	sec="$1"; set="$2"; tcp="$3"; udp="$4"; mk="${5:-}"
	if [ -n "$tcp" ]; then
		uci set "firewall.${sec}_t=rule"
		uci set "firewall.${sec}_t.name=$C-allow-$set-tcp"
		uci set "firewall.${sec}_t.src=$C"
		uci set "firewall.${sec}_t.dest=wan"
		uci set "firewall.${sec}_t.proto=tcp"
		uci set "firewall.${sec}_t.ipset=$set"
		uci set "firewall.${sec}_t.family=ipv4"
		uci set "firewall.${sec}_t.target=ACCEPT"
		[ -n "$mk" ] && uci set "firewall.${sec}_t.mark=$mk"
		for p in $tcp; do uci add_list "firewall.${sec}_t.dest_port=$p"; done
	fi
	if [ -n "$udp" ]; then
		uci set "firewall.${sec}_u=rule"
		uci set "firewall.${sec}_u.name=$C-allow-$set-udp"
		uci set "firewall.${sec}_u.src=$C"
		uci set "firewall.${sec}_u.dest=wan"
		uci set "firewall.${sec}_u.proto=udp"
		uci set "firewall.${sec}_u.ipset=$set"
		uci set "firewall.${sec}_u.family=ipv4"
		uci set "firewall.${sec}_u.target=ACCEPT"
		[ -n "$mk" ] && uci set "firewall.${sec}_u.mark=$mk"
		for p in $udp; do uci add_list "firewall.${sec}_u.dest_port=$p"; done
	fi
}

# fw4 loads ${C}_reg from a plain list, so regenerate it from the table.
sync_macs() {
	mkdir -p "$CONF_DIR"
	{ echo "# generated from $(basename "$REGTSV") -- do not edit by hand"
	  registrations | awk -F'\t' 'NF>=1 && $1 != "" {print $1}'
	} > "$REGMACS"
}

cmd_apply() {
	case "$KEY$STAFF_KEY" in
		*CHANGEME*) die "set KEY and STAFF_KEY in $CONF first" ;;
	esac
	[ ${#KEY} -ge 8 ] || die "KEY must be at least 8 characters"
	[ ${#STAFF_KEY} -ge 8 ] || die "STAFF_KEY must be at least 8 characters"

	sync_macs
	info "regenerating UCI from $CONF_DIR"
	apply_network; apply_wireless; apply_dhcp; apply_firewall

	info "checking ruleset"
	if ! fw4 check >/tmp/classnet-fw4.err 2>&1; then
		uci revert network wireless dhcp firewall
		sed -n '1,20p' /tmp/classnet-fw4.err >&2
		die "fw4 check failed -- changes reverted, nothing applied"
	fi

	# presence sampling: one line per associated MAC per minute
	if [ -x /usr/sbin/classnet-presence ]; then
		c=/etc/crontabs/root; touch "$c"
		grep -q classnet-presence "$c" || echo "* * * * * /usr/sbin/classnet-presence" >> "$c"
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	fi

	uci commit network; uci commit wireless; uci commit dhcp; uci commit firewall
	info "reloading network"
	/etc/init.d/network reload   >/dev/null 2>&1
	/etc/init.d/dnsmasq restart  >/dev/null 2>&1
	/etc/init.d/firewall restart >/dev/null 2>&1
	wifi reload                  >/dev/null 2>&1
	info "applied: $(domains | wc -l | tr -d ' ') allowed names, profiles: $ALWAYS_ON $PROFILES"
}

# ------------------------------------------------------------ ssid on/off ---

# A manual switch and a timetable disagree within the minute. Say so, rather
# than let the cron silently undo what was just typed.
sched_warn() {
	[ -f "$FLAG_SCHED" ] || return 0
	echo "  note: the schedule is on and re-decides this within a minute."
	echo "  To hold it open outside the timetable: classnet session start [name]"
}
cmd_enable()  { rm -f "$FLAG_OFF";  cmd_apply >/dev/null; echo "classnet SSID '$SSID' ENABLED (allowlist active)"; sched_warn; }
cmd_disable() { touch "$FLAG_OFF";  cmd_apply >/dev/null; echo "classnet SSID '$SSID' DISABLED (staff SSID untouched)"; sched_warn; }

cmd_unlock() {
	touch "$FLAG_OPEN"; cmd_apply >/dev/null
	echo "classnet UNLOCKED -- students have unrestricted Internet (deny list still enforced)."
	echo "Re-lock with: classnet lock"
}
cmd_lock() {
	rm -f "$FLAG_OPEN"; cmd_apply >/dev/null
	echo "classnet LOCKED -- allowlist enforced"
}

# ---------------------------------------------------------------- status ----

cmd_status() {
	ssid_off && up=disabled || up=enabled
	is_unlocked && lk="UNLOCKED (unrestricted)" || lk="locked (allowlist enforced)"
	echo "SSID          : $SSID ($up), $STAFF_SSID (staff)"
	echo "Policy        : $lk"
	if [ -f "$FLAG_SCHED" ]; then
		echo "Schedule      : ON -- $SSID follows $(basename "$SCHEDULE")"
	else
		echo "Schedule      : off ($SSID stays up until classnet enable|disable)"
	fi
	echo "Uplink        : $(uplink_line)"
	[ -f "$UPLINK_NOTE" ] && echo "                $(cat "$UPLINK_NOTE")"
	echo "Profiles      : $ALWAYS_ON $PROFILES"
	echo "Allowed names : $(domains | wc -l | tr -d ' ')"
	echo "Denied names  : $(denied | wc -l | tr -d ' ')"
	echo "Staff MACs    : $(staff_macs | wc -l | tr -d ' ')"
	echo "Sign-in page  : http://$PORTAL_HOST  (on $SSID)"
	if [ -n "$ONLINE_HOST" ]; then
		echo "Who is online : http://$ONLINE_HOST  (on $SSID and $STAFF_SSID)"
	else
		echo "Who is online : off (ONLINE_HOST is empty)"
	fi
	echo "Set ${C}_dns4: $(_setcount ${C}_dns4) addresses learned"
	echo "Set ${C}_net4: $(_setcount ${C}_net4) static entries"
	echo
	echo "Clients on $SSID:"
	_clients br-${C} /tmp/dhcp.${C}.leases
	echo "Clients on $STAFF_SSID:"
	_clients br-${C}s /tmp/dhcp.leases
}

_setcount() {
	nft list set inet fw4 "$1" 2>/dev/null \
		| sed -n '/elements = {/,/}/p' | tr ',' '\n' \
		| grep -cE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+'
}

_clients() {
	br="$1"; lease="$2"
	for i in /sys/class/net/"$br"/brif/*; do
		[ -e "$i" ] || continue
		iw dev "$(basename "$i")" station dump 2>/dev/null \
			| sed -n 's/^Station \([0-9a-f:]*\).*/\1/p'
	done | sort -u | while read -r m; do
		ip=$(awk -v m="$m" '$2==m{print $3}' "$lease" 2>/dev/null)
		nm=$(awk -v m="$m" '$2==m{print $4}' "$lease" 2>/dev/null)
		echo "  $m  ${ip:--}  ${nm:--}"
	done | grep . || echo "  (none)"
}

# ------------------------------------------------------------ list edits ----

cmd_staff() {
	case "${1:-list}" in
	add) [ -n "${2:-}" ] || die "usage: classnet staff add <MAC>"
		echo "$2" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || die "not a MAC: $2"
		staff_macs | grep -qix "$2" && { echo "already present"; return; }
		echo "$2" | tr 'A-Z' 'a-z' >> "$MACS"; echo "added $2"; cmd_apply ;;
	del) [ -n "${2:-}" ] || die "usage: classnet staff del <MAC>"
		grep -vix "$2" "$MACS" > "$MACS.new" && mv "$MACS.new" "$MACS"
		echo "removed $2"; cmd_apply ;;
	list) staff_macs ;;
	*) die "usage: classnet staff add|del|list [MAC]" ;;
	esac
}

cmd_allow() {
	case "${1:-list}" in
	add) [ -n "${2:-}" ] || die "usage: classnet allow add <domain> [profile]"
		if [ -n "${3:-}" ]; then
			f=$(ls "$ALLOW_DIR"/*-"$3".list 2>/dev/null | head -1)
			[ -n "$f" ] || die "no such profile: $3"
		else
			f="$ALLOW_DIR/99-local.list"
			[ -f "$f" ] || echo "# profile: local -- added with 'classnet allow add'" > "$f"
		fi
		grep -qxF "$2" "$f" 2>/dev/null && { echo "already present in $(basename "$f")"; return; }
		echo "$2" >> "$f"; echo "added $2 to $(basename "$f")"; cmd_apply ;;
	del) [ -n "${2:-}" ] || die "usage: classnet allow del <domain>"
		for f in "$ALLOW_DIR"/*.list; do
			grep -qxF "$2" "$f" 2>/dev/null || continue
			grep -vxF "$2" "$f" > "$f.new" && mv "$f.new" "$f"
			echo "removed $2 from $(basename "$f")"
		done; cmd_apply ;;
	list) for f in "$ALLOW_DIR"/*.list; do
			p=$(profile_of "$f")
			profile_enabled "$p" && st="on " || st="off"
			strip "$f" | sed "s/^/[$st] $p  /"
		done ;;
	*) die "usage: classnet allow add|del|list [domain] [profile]" ;;
	esac
}

cmd_profile() {
	case "${1:-list}" in
	enable|disable)
		[ -n "${2:-}" ] || die "usage: classnet profile $1 <name>"
		for p in $ALWAYS_ON; do [ "$p" = "$2" ] && die "'$2' is always on"; done
		ls "$ALLOW_DIR"/*-"$2".list >/dev/null 2>&1 || die "no such profile: $2"
		new=""
		for p in $PROFILES; do [ "$p" = "$2" ] || new="$new $p"; done
		[ "$1" = enable ] && new="$new $2"
		new=$(echo "$new" | tr -s ' ' | sed 's/^ //;s/ $//')
		sed -i "s/^PROFILES=.*/PROFILES=\"$new\"/" "$CONF"
		PROFILES="$new"; echo "profiles: $ALWAYS_ON $PROFILES"; cmd_apply ;;
	list)
		for f in "$ALLOW_DIR"/*.list; do
			p=$(profile_of "$f")
			st=off
			profile_enabled "$p" && st=on
			for a in $ALWAYS_ON; do [ "$a" = "$p" ] && st=always; done
			printf '  %-8s %-7s %s names\n' "$p" "$st" "$(strip "$f" | wc -l | tr -d ' ')"
		done ;;
	*) die "usage: classnet profile enable|disable|list [name]" ;;
	esac
}

# ------------------------------------------------------------------ test ----

cmd_test() {
	rc=0
	echo "== on-router checks =="
	dnsmasq --test -C /var/etc/dnsmasq.conf.$C >/dev/null 2>&1 \
		&& echo "  ok   classnet dnsmasq config parses" \
		|| { echo "  FAIL classnet dnsmasq config"; rc=1; }
	fw4 check >/dev/null 2>&1 \
		&& echo "  ok   fw4 ruleset compiles" || { echo "  FAIL fw4 check"; rc=1; }
	nft list set inet fw4 ${C}_net4 2>/dev/null | grep -q 185.199.108.153 \
		&& echo "  ok   static Pages set seeded" || { echo "  FAIL ${C}_net4 empty"; rc=1; }
	nft list set inet fw4 ${C}_dns4 >/dev/null 2>&1 \
		&& echo "  ok   DNS-learned set exists" || { echo "  FAIL ${C}_dns4 missing"; rc=1; }
	pgrep -f "dnsmasq.conf.$C" >/dev/null \
		&& echo "  ok   classnet resolver running" || { echo "  FAIL resolver not running"; rc=1; }
	# The staff-side resolver must answer for .$C itself. If it forwards, the
	# root servers answer a name that does not exist yet with an SOA carrying a
	# 24-hour negative TTL, and the laptop that asked keeps the name broken for
	# a day after the router is right -- a failure that looks like the router
	# and is not.
	grep -qx "server=/$C/" /var/etc/dnsmasq.conf.main 2>/dev/null \
		&& echo "  ok   .$C is answered here, never forwarded to the root" \
		|| { echo "  FAIL main resolver forwards .$C upstream (24h stale NXDOMAIN on clients)"; rc=1; }
	if [ -n "$ONLINE_HOST" ] && [ -x /usr/sbin/classnet-portal ]; then
		# The staff-side listener is the half of the who-is-online page that no
		# test on the student network can see: it binds in its own thread, and
		# a staff interface that was not up when the portal started leaves the
		# page working for students and silently missing for staff.
		netstat -ltn 2>/dev/null | grep -q "$STAFF_IP:$PORTAL_PORT" \
			&& echo "  ok   portal listening for staff on $STAFF_IP:$PORTAL_PORT" \
			|| { echo "  FAIL portal not listening on $STAFF_IP:$PORTAL_PORT -- restart classnet-portal"; rc=1; }
	fi
	# Only a Wi-Fi uplink is checked. A wired one is the stock wan, which this
	# tool neither owns nor configures.
	if uplink_wifi; then
		uplink_up \
			&& echo "  ok   Wi-Fi uplink '$(uplink_get 1)' is connected" \
			|| { echo "  FAIL Wi-Fi uplink '$(uplink_get 1)' is not connected -- see classnet net"; rc=1; }
		uci -q get "firewall.$(wan_zone).network" | tr ' ' '\n' | grep -qx "$WWAN" \
			&& echo "  ok   Wi-Fi uplink is in the wan zone" \
			|| { echo "  FAIL Wi-Fi uplink is not in the wan zone -- run classnet apply"; rc=1; }
	fi

	# $CLASS_IP only exists while the student SSID is up -- the schedule takes
	# it down between sessions, and `classnet disable` removes it outright. Both
	# arms below are worthless without it, and worthless in OPPOSITE directions:
	# every "should resolve" fails for want of a listener, while every "should
	# NOT resolve" passes vacuously, because a resolver that answers nothing
	# refuses everything. Reporting either would be a lie about the allowlist,
	# so say plainly that this half was not tested. Not a failure when the SSID
	# is down on purpose -- but if nothing explains it being down, that IS one.
	if ! ip -4 addr show 2>/dev/null | grep -qw "$CLASS_IP"; then
		echo "== resolver behaviour: NOT TESTED =="
		# Order matters: classnet-schedule brings the SSID down by calling
		# `classnet disable`, so FLAG_OFF is set in BOTH cases. Testing it
		# first would blame the instructor for the timetable's work, and
		# advise `classnet enable` -- which the next schedule tick undoes.
		if [ -f "$FLAG_SCHED" ]; then
			why="the schedule is on and no session is open -- classnet schedule"
		elif [ -f "$FLAG_OFF" ]; then
			why="the SSID is disabled by hand -- classnet enable"
		else
			why="nothing explains it being down -- see classnet status"
			rc=1
		fi
		echo "  skip $CLASS_IP is not up: $why"
		echo "  (run this again during a session to test the allowlist)"
		[ $rc = 0 ] && echo "ALL PASS (resolver half not tested)" \
		            || echo "FAILURES -- see above"
		return $rc
	fi

	echo "== resolver behaviour (asking $CLASS_IP directly) =="
	_q()  { nslookup "$1" "$CLASS_IP" 2>/dev/null | sed -n '/^Name:/,$p' | grep -c '^Address'; }
	# Read the course site out of the profile that defines it rather than
	# naming one here: a hardcoded host silently becomes a permanent FAIL for
	# everyone whose site is not ours.
	site=$(strip "$ALLOW_DIR"/*-site.list 2>/dev/null | head -1)
	for d in github.com "$site" "${ONLINE_HOST:-}" "$PORTAL_HOST"; do
		[ -n "$d" ] || continue
		[ "$(_q "$d")" -gt 0 ] && echo "  ok   $d resolves" || { echo "  FAIL $d should resolve"; rc=1; }
	done
	# These must stay out of every profile in allow.d, or this arm contradicts
	# policy-simtest, which asserts the allowed side of the same policy.
	for d in chatgpt.com api.githubcopilot.com api.anthropic.com; do
		[ "$(_q "$d")" -eq 0 ] && echo "  ok   $d refused" || { echo "  FAIL $d should NOT resolve"; rc=1; }
	done
	[ $rc = 0 ] && echo "ALL PASS" || echo "FAILURES -- see above"
	return $rc
}

cmd_debug() {
	case "${1:-}" in
	on)  touch "$FLAG_DBG"; cmd_apply >/dev/null
	     echo "query logging ON for the student resolver."
	     echo "Reproduce the problem, then: classnet log   (turn off with: classnet debug off)" ;;
	off) rm -f "$FLAG_DBG"; cmd_apply >/dev/null; echo "query logging OFF" ;;
	*)   is_debug && echo "query logging is ON" || echo "query logging is OFF"
	     echo "usage: classnet debug on|off" ;;
	esac
}

# What the student resolver refused, newest last. With `classnet debug on` this
# names every host a laptop asked for and did not get -- which is how you find
# the one CDN or upload bucket a site needs that the allowlist is missing.

# ------------------------------------------------------- presence/identity --

# The AP already knows how long every station has been associated, so presence
# needs no client software, no browser tab and nothing for a student to run.
# `connected time` resets on a roam between the 2.4 and 5 GHz APs, so take the
# largest value seen for a MAC across both.
_stations() {
	for i in /sys/class/net/br-${C}/brif/*; do
		[ -e "$i" ] || continue
		iw dev "$(basename "$i")" station dump 2>/dev/null | awk '
			/^Station/       { mac=$2 }
			/connected time/ { print mac, $3 }'
	done | awk '{ if ($2 > t[$1]) t[$1]=$2 } END { for (m in t) print m, t[m] }'
}

_ident() {  # mac -> "github  name <email>"  or empty
	registrations | awk -F'\t' -v m="$1" '$1==m { printf "%s\t%s\t%s", $4, $3, $2; exit }'
}

# The full identity on one line, in the shape the roster and exports use.
# usf_user is derived rather than stored: it is the local part of the address
# Google verified, so it cannot drift out of step with it.
_identline() {
	id=$(_ident "$1"); [ -n "$id" ] || return 1
	gh=$(echo "$id" | cut -f1); nm=$(echo "$id" | cut -f2); em=$(echo "$id" | cut -f3)
	printf 'usf_user=%s  email=%s  name=%s  github=%s' "${em%%@*}" "$em" "$nm" "$gh"
}

_hms() { awk -v s="${1:-0}" 'BEGIN{printf "%d:%02d", int(s/3600), int(s%3600/60)}'; }

cmd_who() {
	# --github: bare usernames, one per line, for scripting (classnet-release)
	if [ "${1:-}" = "--github" ]; then
		_stations | while read -r mac _; do
			id=$(_ident "$mac"); [ -n "$id" ] && echo "$id" | cut -f1
		done | sort -u
		return
	fi
	gate_on && g="on" || g="OFF"
	echo "In the room now  (registration gate: $g)"
	echo
	_stations | sort -k2 -rn | while read -r mac secs; do
		line=$(_identline "$mac") \
			&& printf '  %-18s %-6s %s\n' "$mac" "$(_hms "$secs")" "$line" \
			|| printf '  %-18s %-6s %s\n' "$mac" "$(_hms "$secs")" "(unregistered -- has not signed in)"
	done
	n=$(_stations | wc -l | tr -d ' ')
	u=$(_stations | while read -r m _; do [ -z "$(_ident "$m")" ] && echo x; done | wc -l | tr -d ' ')
	echo
	echo "  $n device(s) present, $u unregistered, $(registrations | wc -l | tr -d ' ') registered all-time"
}

cmd_roster() {
	# Validation lives in the portal binary so the check and the live lookup
	# share one parser -- a roster that checks clean cannot then fail at the door.
	if [ "${1:-}" = "check" ]; then
		[ -x /usr/sbin/classnet-portal ] || die "classnet-portal is not installed"
		/usr/sbin/classnet-portal --check-roster
		return $?
	fi
	if [ "${1:-}" = "--github" ]; then
		registrations | awk -F'\t' 'NF>=4 && $4!="" {print $4}' | sort -u
		return
	fi
	printf '  %-18s %-10s %-16s %-26s %s\n' MAC USF GITHUB EMAIL NAME
	registrations | sort -t"$(printf '\t')" -k4 | while IFS="$(printf '\t')" read -r mac email name gh ts; do
		printf '  %-18s %-10s %-16s %-26s %s\n' "$mac" "${email%%@*}" "$gh" "$email" "$name"
	done
	echo
	echo "  $(registrations | wc -l | tr -d ' ') device(s) registered"
}

cmd_register() {
	[ $# -ge 3 ] || die "usage: classnet register <MAC> <usf-email> <github-user> [full name]"
	mac=$(echo "$1" | tr 'A-Z' 'a-z')
	echo "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || die "not a MAC: $1"
	case "$2" in *@*usfca.edu) ;; *) die "not a usfca.edu address: $2" ;; esac
    email="$2"; gh="$3"; shift 3; name="${*:-}"
	[ -n "$name" ] || name="$gh"
	mkdir -p "$CONF_DIR"
	[ -f "$REGTSV" ] || printf '# mac\temail\tname\tgithub\tregistered_at\n' > "$REGTSV"
	if registrations | awk -F'\t' -v m="$mac" '$1==m{f=1} END{exit !f}'; then
		cp "$REGTSV" "$REGTSV.bak" 2>/dev/null
		grep -v "^$mac	" "$REGTSV" > "$REGTSV.new" && mv "$REGTSV.new" "$REGTSV"
		echo "  replacing existing registration for $mac"
	fi
	printf '%s\t%s\t%s\t%s\t%s\n' "$mac" "$email" "$name" "$gh" "$(date +%s)" >> "$REGTSV"
	sync_macs
	# live, so the student is unblocked without a ruleset reload
	nft add element inet fw4 ${C}_reg "{ $mac }" 2>/dev/null
	echo "registered $mac -> $gh <$email>"
}

cmd_unregister() {
	[ -n "${1:-}" ] || die "usage: classnet unregister <MAC>"
	mac=$(echo "$1" | tr 'A-Z' 'a-z')
	before=$(registrations | wc -l | tr -d ' ')
	if ! registrations | awk -F'\t' -v m="$mac" '$1==m{f=1} END{exit !f}'; then
		echo "not registered: $mac"
		return 0
	fi
	cp "$REGTSV" "$REGTSV.bak" 2>/dev/null
	grep -v "^$mac	" "$REGTSV" > "$REGTSV.new" 2>/dev/null
	# This file is student identity data. A rewrite that removes anything other
	# than the one row asked for is a bug, and restoring from the snapshot is
	# cheaper than reconstructing a roster mid-session.
	# wc, not grep -c: grep exits 1 when it counts zero, so `grep -c ... || echo 0`
	# emitted "0\n0" and the numeric test then failed with "bad number" -- which
	# an `if` reads as false, so the guard quietly waved the write through.
	after=$(grep -v '^#' "$REGTSV.new" 2>/dev/null | grep -v '^$' | wc -l | tr -d ' ')
	if [ "$after" -ne $((before - 1)) ]; then
		rm -f "$REGTSV.new"
		die "refusing to write: $before row(s) would become $after, expected $((before - 1)). $REGTSV is unchanged."
	fi
	mv "$REGTSV.new" "$REGTSV"
	sync_macs
	nft delete element inet fw4 ${C}_reg "{ $mac }" 2>/dev/null
	echo "unregistered $mac -- it will meet the portal again on its next request"
}

# Every session on a date: the scheduled periods whose weekday matches, plus
# any ad-hoc session that was started that day. Emits "name<TAB>start<TAB>end".
sessions_for() {
	d="$1"
	dow=$(date -d "$d" +%a 2>/dev/null | tr 'A-Z' 'a-z')
	[ -n "$dow" ] || return 1

	if [ -f "$SCHEDULE" ]; then
		strip "$SCHEDULE" | while IFS='|' read -r nm days st en; do
			[ -n "$nm" ] && [ -n "$days" ] || continue
			echo "$days" | tr ',' '\n' | tr -d ' ' | grep -qix "$dow" || continue
			a=$(date -D "%Y-%m-%d %H:%M" -d "$d $st" +%s 2>/dev/null) || continue
			b=$(date -D "%Y-%m-%d %H:%M" -d "$d $en" +%s 2>/dev/null) || continue
			printf '%s\t%s\t%s\n' "$nm" "$a" "$((b + SESSION_BUFFER_MIN * 60))"
		done
	fi

	# Ad-hoc sessions, for work outside the timetable. An open one (end 0) is
	# reported as running up to now.
	[ -f "$ADHOC" ] && awk -v d="$d" -v now="$(date +%s)" '
		!/^#/ && NF>=3 {
			e = ($2 == 0 ? now : $2)
			if (strftime("%Y-%m-%d", $1) == d) {
				name = $3; for (i = 4; i <= NF; i++) name = name " " $i
				printf "%s\t%s\t%s\n", name, $1, e
			}
		}' "$ADHOC" 2>/dev/null
	return 0
}

# Samples inside a window, stitched into one visit per device.
# Emits "mac<TAB>first<TAB>last<TAB>seconds".
_stitch() {
	awk -v a="$2" -v b="$3" -v gap="$((SESSION_GAP_MIN * 60))" '
		$1 >= a && $1 <= b {
			ts = $1; mac = $2
			if (!(mac in first)) first[mac] = ts
			else { d = ts - last[mac]; if (d <= gap) acc[mac] += d }
			last[mac] = ts
		}
		END { for (m in last) printf "%s\t%d\t%d\t%d\n", m, first[m], last[m], acc[m] }
	' "$1" 2>/dev/null
}

_hm() { date -d "@$1" +%H:%M 2>/dev/null; }

# One date, every session on it.
_report_date() {
	d="$1"; only="${2:-}"; f="$ATTEND/$d.log"
	[ -f "$f" ] || return 0
	sessions_for "$d" | sort -k2 -n | while IFS="$(printf '\t')" read -r nm a b; do
		rows=$(_stitch "$f" "$a" "$b")
		[ -n "$rows" ] || continue
		if [ -z "$only" ]; then
			printf '\n%s  %-8s %s-%s\n' "$(date -d "$d" '+%a %Y-%m-%d')" "$nm" "$(_hm "$a")" "$(_hm "$b")"
			printf '  %-16s %-7s %-7s %s\n' GITHUB FIRST LAST TOTAL
		fi
		# Alphabetical by username: this gets read against a roster, and a list
		# ordered by minutes-present is the wrong shape for that.
		echo "$rows" | while IFS="$(printf '\t')" read -r mac fs ls tot; do
			id=$(_ident "$mac"); gh=$(echo "$id" | cut -f1)
			[ -n "$gh" ] || gh="($mac)"
			if [ -n "$only" ]; then
				[ "$gh" = "$only" ] || continue
				printf '  %-12s %-9s %-7s %-7s %s\n' "$d" "$nm" "$(_hm "$fs")" "$(_hm "$ls")" "$(_hms "$tot")"
			else
				printf '  %-16s %-7s %-7s %s\n' "$gh" "$(_hm "$fs")" "$(_hm "$ls")" "$(_hms "$tot")"
			fi
		done | sort
	done
}

_dates() {  # every date with a log, oldest first
	ls "$ATTEND"/*.log 2>/dev/null | sed -e 's|.*/||' -e 's|\.log$||' \
		| grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' | sort
}

cmd_attendance() {
	case "${1:-}" in
	--all)     for d in $(_dates); do _report_date "$d"; done; echo ;;
	--since)   [ -n "${2:-}" ] || die "usage: classnet attendance --since <YYYY-MM-DD>"
	           for d in $(_dates); do [ "$d" \< "$2" ] || _report_date "$d"; done; echo ;;
	--student) [ -n "${2:-}" ] || die "usage: classnet attendance --student <github-username>"
	           who=$(registrations | awk -F'\t' -v g="$2" '$4==g {printf "%s <%s>", $3, $2; exit}')
	           echo "$2${who:+  ($who)}"
	           printf '  %-12s %-9s %-7s %-7s %s\n' DATE SESSION FIRST LAST TOTAL
	           n=0
	           for d in $(_dates); do _report_date "$d" "$2"; done \
	             | tee /tmp/.cn-stu | grep -c . >/dev/null
	           cat /tmp/.cn-stu
	           n=$(grep -c . /tmp/.cn-stu 2>/dev/null || echo 0)
	           echo; echo "  $n session(s) attended"; rm -f /tmp/.cn-stu ;;
	"")        d=$(date +%Y-%m-%d)
	           sessions_for "$d" | grep -q . || { echo "No session scheduled for $(date '+%A'), and none started by hand."; echo "Start one with: classnet session start [name]"; return 0; }
	           echo "Attendance for $d"; _report_date "$d"; echo ;;
	*)         echo "Attendance for $1"; _report_date "$1"; echo ;;
	esac
}

cmd_export() {
	echo "date,session,usf_user,github,email,name,first_seen,last_seen,minutes"
	case "${1:-}" in
	--all)   set -- $(_dates) ;;
	--since) shift; set -- $(for d in $(_dates); do [ "$d" \< "$1" ] || echo "$d"; done) ;;
	"")      set -- "$(date +%Y-%m-%d)" ;;
	esac
	for d in "$@"; do
		f="$ATTEND/$d.log"; [ -f "$f" ] || continue
		sessions_for "$d" | sort -k2 -n | while IFS="$(printf '\t')" read -r nm a b; do
			_stitch "$f" "$a" "$b" | while IFS="$(printf '\t')" read -r mac fs ls tot; do
				id=$(_ident "$mac")
				gh=$(echo "$id" | cut -f1); nmn=$(echo "$id" | cut -f2); em=$(echo "$id" | cut -f3)
				printf '%s,%s,%s,%s,%s,"%s",%s,%s,%d\n' \
					"$d" "$nm" "${em%%@*}" "${gh:-}" "${em:-}" "${nmn:-}" \
					"$(_hm "$fs")" "$(_hm "$ls")" "$((tot / 60))"
			done
		done
	done
}

# Work outside the timetable -- a makeup, an office-hours session, an exam
# review -- still needs an attendance window. This opens one.
cmd_session() {
	mkdir -p "$ATTEND"
	[ -f "$ADHOC" ] || printf '# start_unix end_unix name\n' > "$ADHOC"
	now=$(date +%s)
	# Running means either still open (end 0) or ending later. A --until
	# session is not open in the end-0 sense but is very much still running,
	# and `end` and `status` both have to see it.
	open=$(awk -v now="$now" '!/^#/ && NF>=3 && ($2==0 || $2>now) {print $1"\t"$3"\t"$2; exit}' "$ADHOC" 2>/dev/null)
	case "${1:-status}" in
	start|begin)
		[ -z "$open" ] || die "a session started at $(_hm "$(echo "$open" | cut -f1)") is still running; end it first"
		shift
		until=0
		if [ "${1:-}" = "--until" ]; then
			shift
			[ -n "${1:-}" ] || die "usage: classnet session start --until HH:MM [name]"
			want="$1"; shift
			until=$(date -D "%Y-%m-%d %H:%M" -d "$(date +%Y-%m-%d) $want" +%s 2>/dev/null) \
				|| die "not a time: $want (want HH:MM, today)"
			[ "$until" -gt "$now" ] || die "$want is already past -- sessions do not run backwards"
		fi
		nm="${*:-adhoc}"
		printf '%s %s %s\n' "$now" "$until" "$nm" >> "$ADHOC"
		if [ "$until" = 0 ]; then
			echo "session '$nm' started at $(date +%H:%M) -- end it with: classnet session end"
		else
			echo "session '$nm' started at $(date +%H:%M), ends at $(_hm "$until")"
			echo "  it closes itself then; classnet session end closes it sooner"
		fi
		sched_now ;;
	# `begin` and `stop` because they are the words people reach for. `start`
	# and `end` stay the names in the docs; two spellings that work, one that
	# gets written down.
	end|stop)
		[ -n "$open" ] || die "no session is running"
		st=$(echo "$open" | cut -f1); nm=$(echo "$open" | cut -f2)
		# Matches on the start alone: a --until session has a non-zero end
		# already, and ending early means overwriting it rather than skipping it.
		awk -v s="$st" -v e="$now" '!/^#/ && $1==s {$2=e} {print}' "$ADHOC" > "$ADHOC.new" \
			&& mv "$ADHOC.new" "$ADHOC"
		echo "session '$nm' ended at $(date +%H:%M) ($(_hms $(( $(date +%s) - st )) ) elapsed)"
		echo "See who was present: classnet attendance"
		sched_now ;;
	status)
		if [ -n "$open" ]; then
			st=$(echo "$open" | cut -f1); nm=$(echo "$open" | cut -f2); en=$(echo "$open" | cut -f3)
			if [ "$en" = 0 ]; then
				echo "session '$nm' open since $(_hm "$st") -- no end time, it will not close itself"
			else
				echo "session '$nm' open since $(_hm "$st"), ends at $(_hm "$en")"
			fi
		else
			d=$(date +%Y-%m-%d)
			echo "no ad-hoc session open"
			if ! sessions_for "$d" | grep -q .; then
				echo "  nothing scheduled on a $(date '+%A') either"
				echo "  start one with: classnet session start [name]"
			fi
			sessions_for "$d" | while IFS="$(printf '\t')" read -r nm a b; do
				now=$(date +%s)
				[ "$now" -ge "$a" ] && [ "$now" -le "$b" ] \
					&& echo "  scheduled '$nm' is running now ($(_hm "$a")-$(_hm "$b"))" \
					|| echo "  scheduled '$nm' today $(_hm "$a")-$(_hm "$b")"
			done
		fi ;;
	reap)
		# A session left open is reported as running up to *now*, forever. A
		# forgotten office hour therefore becomes a twenty-hour window with
		# everyone who passed the router in it, and with a schedule armed it
		# holds the SSID open all evening. Close it at the end of the day it
		# started on: the network was not a class after midnight whatever the
		# file says. Announced, because it edits an attendance record.
		today=$(date +%Y-%m-%d)
		for s in $(awk '!/^#/ && NF>=3 && $2==0 {print $1}' "$ADHOC" 2>/dev/null); do
			d=$(date -d "@$s" +%Y-%m-%d 2>/dev/null) || continue
			[ "$d" = "$today" ] && continue
			eod=$(date -D "%Y-%m-%d %H:%M:%S" -d "$d 23:59:59" +%s 2>/dev/null) || continue
			nm=$(awk -v s="$s" '$1==s {n=$3; for (i=4; i<=NF; i++) n=n" "$i; print n; exit}' "$ADHOC")
			awk -v s="$s" -v e="$eod" '!/^#/ && $1==s && $2==0 {$2=e} {print}' "$ADHOC" > "$ADHOC.new" \
				&& mv "$ADHOC.new" "$ADHOC"
			logger -t classnet "session: '$nm' was left open on $d -- closed at the end of that day"
			echo "closed '$nm', left open on $d"
		done
		return 0 ;;
	windows)
		# What classnet-schedule reads. Deliberately the same sessions_for the
		# attendance report uses: two parsers would let the network be open at
		# a time that is not counted.
		sessions_for "$(date +%Y-%m-%d)" ;;
	*) die "usage: classnet session start|begin [--until HH:MM] [name] | end|stop | status" ;;
	esac
}

# Re-decide immediately, so `session start` opens the network now rather than
# up to a minute from now, and `session end` closes it on the same breath.
sched_now() {
	[ -f "$FLAG_SCHED" ] || return 0
	[ -x /usr/sbin/classnet-schedule ] || return 0
	/usr/sbin/classnet-schedule
}

# The timetable as an enforcement rather than a report. Ships off, and stays a
# deliberate act: see classnet-schedule for why.
cmd_schedule() {
	case "${1:-}" in
	on)  strip "$SCHEDULE" 2>/dev/null | grep -q . \
	         || die "no periods in $SCHEDULE -- nothing to enforce"
	     touch "$FLAG_SCHED"
	     echo "schedule ON -- $SSID is open only during the periods in"
	     echo "$(basename "$SCHEDULE"), or while an ad-hoc session is open."
	     echo "Outside those it is taken down, dropping every laptop still on it."
	     sched_now ;;
	off) rm -f "$FLAG_SCHED"
	     echo "schedule OFF -- $SSID stays as it is until classnet enable|disable" ;;
	"")  if [ -f "$FLAG_SCHED" ]; then
	         echo "schedule is ON"
	         [ -x /usr/sbin/classnet-schedule ] && /usr/sbin/classnet-schedule --dry-run
	     else
	         echo "schedule is OFF -- $SSID is up until you take it down by hand"
	     fi ;;
	*)   die "usage: classnet schedule on|off" ;;
	esac
}

cmd_gate() {
	case "${1:-}" in
	on)  touch "$FLAG_GATE"; cmd_apply >/dev/null
	     echo "registration gate ON -- an unregistered device now reaches only"
	     echo "the sign-in garden. Devices already connected are cut off until"
	     echo "they register. Manual override: classnet register <mac> <email> <gh>" ;;
	off) rm -f "$FLAG_GATE"; cmd_apply >/dev/null
	     echo "registration gate OFF -- every device on classnet gets the allowlist" ;;
	# No argument is a question, not a mistake. install.sh calls it bare to
	# report state, and ending a clean install on a usage line reads as though
	# something went wrong.
	"")  gate_on && echo "registration gate is ON" || echo "registration gate is OFF" ;;
	*)   die "usage: classnet gate on|off" ;;
	esac
}

# ---------------------------------------------------------------- uplink ----

# netifd's view of the uplink, one field at a time. Asked over ubus directly
# rather than through /lib/functions/network.sh: that library reads variables
# it never set, and this script runs under `set -u`.
uplink_st() { ubus call "network.interface.$WWAN" status 2>/dev/null | jsonfilter -e "$1" 2>/dev/null; }
# Up means associated AND holding a lease: netifd does not call a DHCP
# interface up until it has an address.
uplink_up() { case "$(uplink_st '@.up')" in true|1) return 0 ;; esac; return 1; }

band_of() {
	case "$(uci -q get "wireless.$1.band")" in
	2g) echo "2.4 GHz" ;; 5g) echo "5 GHz" ;; 6g) echo "6 GHz" ;; *) echo "$1" ;;
	esac
}

# The interfaces netifd has up on a radio. A scan has to go through one of
# them: this iwinfo takes an interface, not a radio.
radio_ifs() {
	ubus call network.wireless status 2>/dev/null \
		| jsonfilter -e "@.$1.interfaces[*].ifname" 2>/dev/null
}

# the uplink client's own interface, once netifd has created it
uplink_sta() {
	ubus call network.wireless status 2>/dev/null \
		| jsonfilter -e "@.$(uplink_get 3).interfaces[@.section='${C}_sta'].ifname" 2>/dev/null | head -1
}

# The interface traffic actually leaves by, whatever is configured. Not the
# same question as "which uplink is set": a cable in the WAN port outranks the
# Wi-Fi uplink, and either one may simply be down.
live_dev() {
	ip -4 route get "${UPSTREAM_DNS%% *}" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1
}

uplink_line() {
	if ! uplink_wifi; then echo "ethernet (the wired WAN port)"; return; fi
	if uplink_up; then
		u_ch=$(iw dev "$(uplink_sta)" info 2>/dev/null | sed -n 's/.*channel \([0-9]*\) .*/\1/p' | head -1)
		echo "Wi-Fi '$(uplink_get 1)' on $(band_of "$(uplink_get 3)")${u_ch:+ channel $u_ch}, address $(uplink_st '@["ipv4-address"][0].address')"
	else
		echo "Wi-Fi '$(uplink_get 1)' on $(band_of "$(uplink_get 3)") -- NOT CONNECTED"
	fi
}

# <radio> <ssid> -> "signal channel encryption" for the strongest AP with that
# name, or nothing. The name is handed to awk through the environment: -v
# would read backslash escapes into it.
uplink_scan() {
	for u_if in $(radio_ifs "$1"); do
		# Judged by content, not exit status: this iwinfo exits 0 even when it
		# could not scan at all. No cells means try the radio's next interface.
		u_out=$(iwinfo "$u_if" scan 2>/dev/null)
		printf '%s\n' "$u_out" | grep -q '^Cell ' || continue
		printf '%s\n' "$u_out" | WANT="\"$2\"" awk '
			function keep() {
				if (essid == ENVIRON["WANT"] && ch != "" && (!found || sig + 0 > bsig + 0)) {
					found = 1; bsig = sig; bch = ch; benc = enc
				}
			}
			/^Cell [0-9]+ - Address:/ { keep(); essid = ""; ch = ""; sig = ""; enc = ""; next }
			/^[ \t]*ESSID: /      { sub(/^[ \t]*ESSID: /, ""); essid = $0; next }
			/^[ \t]*Mode: /       { for (i = 1; i < NF; i++) if ($i == "Channel:") ch = $(i + 1); next }
			/^[ \t]*Signal: /     { sig = $2; next }
			/^[ \t]*Encryption: / { sub(/^[ \t]*Encryption: /, ""); enc = $0; next }
			END { keep(); if (found) print bsig, bch, benc }'
		return
	done
}

# <ssid> -> "rank radio channel encryption" for the radio to put the client
# on, lowest rank best. 5 GHz first, for the capacity -- but not on a radar
# channel while 2.4 GHz offers the same network: an AP that follows its client
# onto one has to listen for radar before it may transmit again.
uplink_find() {
	for r in 0 1; do
		uci -q get "wireless.radio$r" >/dev/null || continue
		u_cell=$(uplink_scan "radio$r" "$1")
		[ -n "$u_cell" ] || continue
		u_c=$(echo "$u_cell" | cut -d' ' -f2)
		if   [ "$u_c" -le 14 ]; then u_rank=2
		elif [ "$u_c" -ge 52 ] && [ "$u_c" -le 144 ]; then u_rank=3
		else u_rank=1
		fi
		echo "$u_rank radio$r $(echo "$u_cell" | cut -d' ' -f2-)"
	done | sort -n | head -1
}

# Do two IPv4 networks share any address? Compared at the shorter prefix.
overlaps() {
	awk -v a="$1" -v am="$2" -v b="$3" -v bm="$4" 'BEGIN {
		m = (am + 0 < bm + 0) ? am + 0 : bm + 0
		split(a, x, "."); split(b, y, ".")
		ai = ((x[1] * 256 + x[2]) * 256 + x[3]) * 256 + x[4]
		bi = ((y[1] * 256 + y[2]) * 256 + y[3]) * 256 + y[4]
		d = 2 ^ (32 - m)
		exit !(int(ai / d) == int(bi / d))
	}'
}

uplink_restore() {
	if [ -f "$UPLINK_PREV" ]; then mv "$UPLINK_PREV" "$UPLINK"; else rm -f "$UPLINK"; fi
}

# A switch that did not work is undone, not left for someone to notice: the
# band the client sits on has no APs for as long as it keeps trying.
uplink_undo() {
	uplink_restore
	( cmd_apply >/dev/null 2>&1 )
	logger -t classnet "uplink: $1 -- put back as it was"
	die "$1. Uplink put back as it was."
}

cmd_net() {
	case "$UPLINK_GIVEUP_MIN" in
		''|*[!0-9]*) die "UPLINK_GIVEUP_MIN in $CONF must be a whole number of minutes (0 = never give up)" ;;
	esac
	case "${1:-}" in
	wifi)
		{ [ $# -eq 3 ] && [ -n "$2" ] && [ -n "$3" ]; } \
			|| die "usage: classnet net wifi <ssid> <password>   (quote either one if it has spaces)"
		u_ssid="$2"; u_key="$3"
		[ ${#u_ssid} -le 32 ] || die "an SSID is at most 32 characters"
		{ [ ${#u_key} -ge 8 ] && [ ${#u_key} -le 63 ]; } || die "a Wi-Fi password is 8 to 63 characters"
		[ "$(printf '%s' "$u_ssid$u_key" | tr -d '\001-\037\177')" = "$u_ssid$u_key" ] \
			|| die "control characters in the SSID or password"
		case "$u_ssid" in
			"$SSID"|"$STAFF_SSID") die "'$u_ssid' is this router's own network" ;;
		esac
		[ -n "$(wan_zone)" ] || die "no firewall zone named 'wan' on this router -- nothing to attach an uplink to"

		if uplink_wifi && [ "$(uplink_get 1)" = "$u_ssid" ] && [ "$(uplink_get 2)" = "$u_key" ] && uplink_up; then
			echo "uplink is already $(uplink_line)"
			return 0
		fi

		# Look before touching anything. A name that is not on the air is a
		# typo or a hotspot that is switched off, and either way the cheapest
		# moment to say so is now, while both bands are still up.
		#
		# Two passes, keeping the better find, and only a first-choice find
		# ends the search early. One pass can miss an AP that is there: seen
		# on this router, a network on both bands answered on 2.4 GHz only,
		# and settling for that moved a working 5 GHz uplink to the other
		# radio and restarted both bands to do it.
		echo "looking for '$u_ssid' -- both bands stutter for a few seconds while this scans"
		u_pick=""
		for u_try in 1 2; do
			u_new=$(uplink_find "$u_ssid")
			if [ -n "$u_new" ] && { [ -z "$u_pick" ] || [ "${u_new%% *}" -lt "${u_pick%% *}" ]; }; then
				u_pick=$u_new
			fi
			[ "${u_pick%% *}" = 1 ] && break
		done
		[ -n "$u_pick" ] || die "no network named '$u_ssid' in range -- nothing changed.
  The name must match exactly. An iPhone may stop advertising its hotspot
  unless the Personal Hotspot screen is open, and its default name has a curly
  apostrophe that is hard to type and may not match: give the phone a plain
  name in Settings > General > About > Name."
		u_rest=${u_pick#* }; u_radio=${u_rest%% *}
		u_rest=${u_rest#* }; u_ch=${u_rest%% *}; u_seen=${u_rest#* }
		u_band=$(band_of "$u_radio")
		# iwinfo lists the key types a network offers. Anything that is not a
		# shared password cannot be joined with one.
		case "$u_seen" in
		*SAE*PSK*|*PSK*SAE*) u_enc=sae-mixed ;;
		*SAE*)               u_enc=sae ;;
		*PSK*)               u_enc=psk2 ;;
		*802.1[xX]*) die "'$u_ssid' wants a username as well as a password (802.1X) -- only shared-password networks can be an uplink. Nothing changed." ;;
		*)           die "'$u_ssid' is open or uses legacy encryption ($u_seen) -- not usable as an uplink. Nothing changed." ;;
		esac

		# From here the radio restarts, and with it possibly the very session
		# this was typed into. Finish regardless: half a switch with nobody
		# left to undo it is the one outcome worth preventing.
		trap '' HUP PIPE
		rm -f "$UPLINK_PREV" "$UPLINK_MISS" "$UPLINK_NOTE"
		[ -f "$UPLINK" ] && cp -p "$UPLINK" "$UPLINK_PREV"
		( umask 077; printf '%s\n%s\n%s\n%s\n' "$u_ssid" "$u_key" "$u_radio" "$u_enc" > "$UPLINK" )
		if [ -f "$UPLINK_PREV" ] && [ "$(sed -n 3p "$UPLINK_PREV")" != "$u_radio" ]; then
			echo "joining on $u_band channel $u_ch -- the uplink changes radio, so $SSID and $STAFF_SSID drop on BOTH bands for a few seconds"
		else
			echo "joining on $u_band channel $u_ch -- $SSID and $STAFF_SSID drop on that band for a few seconds"
		fi
		[ "$u_ch" -ge 52 ] && [ "$u_ch" -le 144 ] \
			&& echo "  note: channel $u_ch is a radar (DFS) channel; that band can take a minute or more to return"
		# A subshell, so a `die` inside apply comes back here with the state
		# file still to be put right, instead of exiting with it changed.
		( cmd_apply >/dev/null ) || { uplink_restore; die "could not apply -- uplink unchanged"; }

		# The pause is for a switch from one Wi-Fi uplink to another: netifd
		# must have let go of the old lease before "up" can mean the new one.
		sleep 3; u_n=3
		while [ $u_n -lt 45 ] && ! uplink_up; do sleep 3; u_n=$((u_n + 3)); done
		if ! uplink_up; then
			if iw dev "$(uplink_sta)" link 2>/dev/null | grep -q '^Connected'; then
				uplink_undo "joined '$u_ssid' but it gave this router no address"
			fi
			uplink_undo "could not join '$u_ssid' -- wrong password, or it went out of range"
		fi

		u_ip=$(uplink_st '@["ipv4-address"][0].address'); u_mask=$(uplink_st '@["ipv4-address"][0].mask')
		u_dev=$(uplink_st '@.l3_device')
		{ [ -n "$u_ip" ] && [ -n "$u_mask" ] && [ -n "$u_dev" ]; } \
			|| uplink_undo "joined '$u_ssid' but could not read the address it gave"
		# An upstream that numbers its clients out of one of OUR subnets cannot
		# be routed to: the router would be looking for its own gateway on the
		# wrong side of itself.
		u_clash=""
		overlaps "$u_ip" "$u_mask" "$CLASS_IP" 24 && u_clash="$SSID ($NET.0/24)"
		overlaps "$u_ip" "$u_mask" "$STAFF_IP" 24 && u_clash="$STAFF_SSID ($STAFF_NET.0/24)"
		u_lan=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
		u_lanm=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].mask' 2>/dev/null)
		[ -n "$u_lan" ] && overlaps "$u_ip" "$u_mask" "$u_lan" "${u_lanm:-24}" \
			&& u_clash="this router's own LAN ($u_lan/${u_lanm:-24})"
		[ -z "$u_clash" ] || uplink_undo "'$u_ssid' hands out $u_ip/$u_mask, which collides with $u_clash"

		# Through the uplink's own interface, so a cable still in the WAN port
		# cannot answer on its behalf. The resolvers, because reaching them is
		# exactly what the student network needs from an uplink.
		u_net=0
		for u_try in 1 2; do
			for u_d in $UPSTREAM_DNS; do
				ping -c 1 -W 3 -I "$u_dev" "$u_d" >/dev/null 2>&1 && { u_net=1; break 2; }
			done
		done
		[ $u_net = 1 ] || uplink_undo "joined '$u_ssid' but nothing answers beyond it -- no Internet there, or a sign-in page in the way"

		rm -f "$UPLINK_PREV"
		echo "uplink is WIFI -- '$u_ssid' on $u_band channel $u_ch, address $u_ip"
		echo "$SSID and $STAFF_SSID on $u_band now sit on that channel, and go off the air"
		echo "whenever '$u_ssid' is out of reach. The other band does not depend on it."
		if [ "$UPLINK_GIVEUP_MIN" -gt 0 ]; then
			echo "Rejoined after a reboot; dropped for the wired port if it stays down $UPLINK_GIVEUP_MIN minutes."
		else
			echo "Rejoined after a reboot, and kept however long it stays down (UPLINK_GIVEUP_MIN=0)."
		fi
		[ "$(live_dev)" = "$u_dev" ] \
			|| echo "note: a cable in the WAN port still carries the traffic -- pull it to move to '$u_ssid'."
		echo "Back to the wired port with: classnet net ethernet" ;;
	ethernet)
		[ $# -eq 1 ] || die "usage: classnet net ethernet"
		if uplink_wifi; then
			trap '' HUP PIPE
			u_ssid=$(uplink_get 1); u_band=$(band_of "$(uplink_get 3)")
			rm -f "$UPLINK_PREV" "$UPLINK_MISS" "$UPLINK_NOTE"
			cp -p "$UPLINK" "$UPLINK_PREV"; rm -f "$UPLINK"
			( cmd_apply >/dev/null ) || { uplink_restore; die "could not apply -- uplink unchanged"; }
			rm -f "$UPLINK_PREV"
			echo "uplink is ETHERNET -- the wired WAN port. '$u_ssid' and its password are forgotten."
			echo "$SSID and $STAFF_SSID on $u_band are back on their own channel."
		else
			rm -f "$UPLINK_NOTE"
			echo "uplink is ETHERNET -- the wired WAN port (it already was)"
		fi
		[ -n "$(live_dev)" ] \
			|| echo "note: nothing answers on the WAN port yet -- no Internet until a cable is in." ;;
	check)
		# The give-up rule, from cron every minute; says nothing unless it acts.
		# A Wi-Fi uplink that is gone keeps one whole band of class Wi-Fi off
		# the air for as long as the router keeps looking for it, so after
		# UPLINK_GIVEUP_MIN minutes stop looking. It tests the link and not the
		# Internet behind it: a hotspot that loses signal for a moment must not
		# reconfigure the router. The count lives in /tmp, so a reboot starts
		# it again and a cold start gets the whole allowance.
		uplink_wifi || { rm -f "$UPLINK_MISS"; return 0; }
		[ "$UPLINK_GIVEUP_MIN" -gt 0 ] || return 0
		# a switch in progress is not an outage, and undoes itself if it fails
		pgrep -f "classnet net wifi" >/dev/null 2>&1 && return 0
		if uplink_up; then rm -f "$UPLINK_MISS"; return 0; fi
		u_n=$(cat "$UPLINK_MISS" 2>/dev/null)
		case "$u_n" in ''|*[!0-9]*) u_n=0 ;; esac
		u_n=$((u_n + 1)); echo "$u_n" > "$UPLINK_MISS"
		[ "$u_n" -ge "$UPLINK_GIVEUP_MIN" ] || return 0
		u_ssid=$(uplink_get 1)
		cp -p "$UPLINK" "$UPLINK_PREV"; rm -f "$UPLINK"
		if ( cmd_apply >/dev/null 2>&1 ); then
			rm -f "$UPLINK_PREV" "$UPLINK_MISS"
			# No RTC, and the usual reason to be here is an uplink that never
			# came up after a boot -- which is also why the clock never synced.
			# A time off that clock would be a confident lie, so only give one
			# that ntpd has confirmed (the flag classnet-schedule waits on).
			u_at=""; [ -f /var/state/classnet-clock ] && u_at=" at $(date '+%H:%M')"
			echo "Wi-Fi uplink '$u_ssid' was dropped$u_at after $u_n minutes down" > "$UPLINK_NOTE"
			logger -t classnet "uplink: Wi-Fi '$u_ssid' down for $u_n minutes -- back to the wired WAN port"
		else
			# state and config must keep agreeing; the next minute tries again
			uplink_restore
			logger -t classnet "uplink: Wi-Fi '$u_ssid' down for $u_n minutes, but giving it up failed to apply"
		fi ;;
	# No argument is a question, as with gate and schedule.
	"")
		echo "uplink is $(uplink_line)"
		if uplink_wifi && ! uplink_up; then
			echo "  $SSID and $STAFF_SSID are off the air on $(band_of "$(uplink_get 3)") while it is not connected."
			if [ "$UPLINK_GIVEUP_MIN" -gt 0 ]; then
				echo "  It is dropped for the wired port after $UPLINK_GIVEUP_MIN minutes down; now: classnet net ethernet"
			else
				echo "  It is kept however long that lasts (UPLINK_GIVEUP_MIN=0); to stop: classnet net ethernet"
			fi
		fi
		[ -f "$UPLINK_NOTE" ] && echo "  note: $(cat "$UPLINK_NOTE")"
		u_dev=$(live_dev)
		if [ -z "$u_dev" ]; then
			echo "  no route to the Internet right now"
		elif uplink_wifi && [ "$u_dev" = "$(uplink_st '@.l3_device')" ]; then
			echo "  traffic leaves over the Wi-Fi uplink ($u_dev)"
		else
			echo "  traffic leaves over the wired WAN port ($u_dev)"
		fi ;;
	*)	die "usage: classnet net | net ethernet | net wifi <ssid> <password>" ;;
	esac
}

cmd_log() {
	if is_debug; then
		echo "== names refused to students (config /var/etc/dnsmasq.conf.$C) =="
		logread | grep -F "dnsmasq[" | grep -E "config .* is NXDOMAIN|/#/" \
			| sed -nE 's/.*config ([^ ]+) is.*/  \1/p' | awk '!s[$0]++' | tail -40
		echo "== allowed lookups =="
		logread | grep -F "dnsmasq[" | sed -nE 's/.*reply ([^ ]+) is .*/  \1/p' \
			| awk '!s[$0]++' | tail -20
	else
		echo "(run 'classnet debug on' first to log which names are being refused)"
	fi
	echo "== recent wifi/auth events =="
	logread | grep -iE "hostapd|PSK-MISMATCH" | tail -10
	# What classnet itself did without being asked: the schedule opening and
	# closing the SSID, and attendance logs expiring. Both drop people or data
	# on a timer, so they belong next to the wifi events rather than only in
	# syslog where nobody thinks to look.
	echo "== what classnet did on its own =="
	logread | grep -F "classnet:" | tail -10
}

usage() {
	cat <<EOF
classnet -- CS 326 classroom network control

  classnet enable | disable        turn the student SSID (and its rules) on/off
  classnet lock   | unlock         enforce / suspend the allowlist, SSID stays up
  classnet status                  what is on, what is connected, set sizes
  classnet apply                   regenerate all config from /etc/classnet
  classnet test                    self-check: resolver, ruleset, sets
  classnet staff   add|del|list <MAC>
  classnet allow   add|del|list <domain> [profile]
  classnet profile enable|disable|list <name>
  classnet who                     who is in the room right now, and for how long
  classnet roster                  every registered student and device
  classnet roster check            validate roster.csv against GitHub
  classnet attendance              today's sessions
  classnet attendance <date>       one date
  classnet attendance --all        every session on record
  classnet attendance --since <date>
  classnet attendance --student <github>   one person across the term
  classnet export [--all|--since <date>|<date>]   the same as CSV
  classnet session start | begin [name]   open an attendance window outside the timetable
  classnet session start --until HH:MM [name]   the same, closing itself at HH:MM
  classnet session end | stop
  classnet session status
  classnet schedule on|off         open the student SSID only during class periods
  classnet gate on|off             require registration before the allowlist applies
  classnet net                     which uplink the class networks go out by
  classnet net wifi <ssid> <password>   join an existing Wi-Fi and use it as the uplink
  classnet net ethernet            back to the wired WAN port
  classnet register <MAC> <usf-email> <github> [name]     bind a device by hand
  classnet unregister <MAC>        send a device back to the portal
  classnet forget registrations|attendance|leases|all   clean slate
  classnet debug on|off            log which names the student resolver refuses
  classnet log                     refused names, wifi events, and what classnet did on its own
EOF
}

case "${1:-}" in
	enable) cmd_enable ;; disable) cmd_disable ;;
	schedule) shift; cmd_schedule "$@" ;;
	lock) cmd_lock ;;     unlock) cmd_unlock ;;
	status) cmd_status ;; apply) cmd_apply ;;  test) cmd_test ;;
	who) shift; cmd_who "$@" ;;   roster) shift; cmd_roster "$@" ;;
	gate) shift; cmd_gate "$@" ;;
	net) shift; cmd_net "$@" ;;
	register) shift; cmd_register "$@" ;;
	unregister) shift; cmd_unregister "$@" ;;
	forget) shift; cmd_forget "$@" ;;
	attendance) shift; cmd_attendance "$@" ;;
	session) shift; cmd_session "$@" ;;
	export) shift; cmd_export "$@" ;;
	staff) shift; cmd_staff "$@" ;;
	allow) shift; cmd_allow "$@" ;;
	profile) shift; cmd_profile "$@" ;;
	log) cmd_log ;;
	debug) shift; cmd_debug "$@" ;;
	*) usage; exit 1 ;;
esac
