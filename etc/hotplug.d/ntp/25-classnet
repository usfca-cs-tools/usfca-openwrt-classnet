# Tell classnet-schedule the wall clock can be trusted.
#
# These boards have no RTC. At boot sysfixtime restores the clock from the
# newest mtime under /etc, so the router comes back believing it is whenever it
# last wrote a file -- stale by exactly the length of the power cut. A schedule
# acting on that can take the SSID down in the middle of a class, which is the
# one failure this feature must not have.
#
# So the schedule holds until ntpd says the time is real. Same gate dnsmasq
# uses before it will trust a DNSSEC signature; see 25-dnsmasqsec beside this.
TIMEVALIDFILE=/var/state/classnet-clock

[ "$ACTION" = "stratum" ] || exit 0

[ -f "$TIMEVALIDFILE" ] || {
	mkdir -p /var/state
	echo "ntpd says time is valid" > "$TIMEVALIDFILE"
	logger -t classnet "clock confirmed by ntpd -- schedule is live"
	# Decide now rather than up to a minute from now: after an outage during
	# class, that minute is the one the room is waiting through.
	[ -x /usr/sbin/classnet-schedule ] && /usr/sbin/classnet-schedule
}
